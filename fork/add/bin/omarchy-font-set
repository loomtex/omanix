#!/bin/bash

# omanix: replaces upstream bin/omarchy-font-set sha256 ee71d07265d2b352ed606d9587741c5f21c1f13f3a158e1d3420ad5547a3b678
# P4 (DESIGN §f.4.4): the terminal configs and fontconfig's fonts.conf are
# read-only home-manager files, so the chosen font goes into their runtime
# overlays (loaded last, so they win) through `omanix-overlay`. "Make it
# stick" turns it into omanix.fonts.monospace.

# omarchy:summary=Set the system monospace font
# omarchy:args=<font-name>
# omarchy:examples=omarchy font list | omarchy font set "CaskaydiaMono Nerd Font"

usage() {
  echo "Usage: omarchy-font-set <font-name>"
}

font_name="${1:-}"

case "$font_name" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if ! fc-list | grep -Fqi -- "$font_name"; then
  echo "Font '$font_name' not found."
  exit 1
fi

# The name lands in TOML, ghostty, foot and fontconfig XML values.
if [[ ! $font_name =~ ^[A-Za-z0-9\ _.+-]+$ ]]; then
  echo "Font '$font_name' has characters omanix can't write into the terminal configs." >&2
  exit 1
fi

for face in normal bold italic; do
  omanix-overlay kv alacritty.toml "font.$face.family" "\"$font_name\""
done

omanix-overlay kv kitty.conf font_family "$font_name"
pkill -USR1 kitty

omanix-overlay kv ghostty.conf font-family "\"$font_name\""
pkill -SIGUSR2 ghostty

# foot keeps family and size in one key; keep the current size.
foot_font=$(omanix-overlay get foot.ini font 2>/dev/null || sed -n 's/^font=//p' ~/.config/foot/foot.ini 2>/dev/null | head -1)
foot_size=$(grep -oE ':size=[0-9.]+' <<<"$foot_font" | head -1)
omanix-overlay kv foot.ini font "$font_name${foot_size:-:size=9}"

# fontconfig is the canonical source of truth — the omarchy shell, Qt apps,
# and anything resolving "monospace" all read from here. The overlay is
# included by the HM fonts.conf after its own rule, and prepend_first puts the
# chosen family at the head of the list so it wins.
omanix-overlay font "$font_name"

omarchy-restart-shell

if pgrep -x ghostty; then
  omarchy-notification-send -g  "$(omarchy-i18n font.restartToSeeChange Ghostty)"
fi

if pgrep -x foot; then
  omarchy-notification-send -g  "$(omarchy-i18n font.restartToSeeChange Foot)"
fi

omarchy-hook font-set "$font_name"
