#!/bin/bash

# omanix: replaces upstream bin/omarchy-reinstall-configs sha256 d9abe210296025eacefccde07de805c89f164d2c7832da56eb5b1363ad3d0160
# omarchy:summary=Clear every runtime overlay back to the declared configuration.
