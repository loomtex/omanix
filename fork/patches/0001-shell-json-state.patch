From: Ada <ada@6bit.com>
Date: Wed, 28 Oct 2026 17:01:32 -0600
Subject: [PATCH] P1: shell.qml keeps the user shell.json in runtime state
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

~/.config/omarchy/shell.json -> ~/.local/state/omanix/shell/shell.json, so
the bar/dock/plugin settings the GUI writes are runtime state, not an
HM-owned file (DESIGN §f.2.5 P1, §f.4.7).
---
 shell/shell.qml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/shell/shell.qml b/shell/shell.qml
index 4de346d..688dc41 100644
--- a/shell/shell.qml
+++ b/shell/shell.qml
@@ -34,7 +34,7 @@ ShellRoot {
   readonly property string shellPath: omarchyPath + "/shell"
   readonly property string firstPartyPluginsDir: shellPath + "/plugins"
   readonly property string defaultsPath: omarchyPath + "/config/omarchy/shell.json"
-  readonly property string userConfigPath: home + "/.config/omarchy/shell.json"
+  readonly property string userConfigPath: home + "/.local/state/omanix/shell/shell.json"
 
   // Bundled fallback so the shell can start even when the default shell.json is
   // missing or unreadable. The bar config here mirrors the on-disk defaults
