From: Ada <ada@6bit.com>
Date: Wed, 28 Oct 2026 17:01:54 -0600
Subject: [PATCH] P9: agent keys open the resident chat and the approval card
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SUPER+A toggles omanix.chat (Josh, 2026-10-28: chat is the primary UI, so
it gets the easiest chord). Upstream's "Select all" on SUPER+A moves to
SUPER+SHIFT+CTRL+A, freed by dropping omarchy-agent --pick (the human's own
harness). SUPER+ALT+A opens omanix.approval.
---
diff --git a/default/hypr/bindings/clipboard.lua b/default/hypr/bindings/clipboard.lua
index a44fe15..7a14bde 100644
--- a/default/hypr/bindings/clipboard.lua
+++ b/default/hypr/bindings/clipboard.lua
@@ -42,7 +42,9 @@ local function universal_clipboard_shortcut(default_mods, default_key, terminal_
   end
 end
 
-o.bind("SUPER + A", "Select all", send_shortcut_once("CTRL", "A"))
+-- omanix: SUPER + A opens the agent chat (utilities.lua); Select all moves
+-- to the chord upstream used for omarchy-agent --pick.
+o.bind("SUPER + SHIFT + CTRL + A", "Select all", send_shortcut_once("CTRL", "A"))
 o.bind("SUPER + C", "Universal copy", universal_clipboard_shortcut("CTRL", "C", "CTRL SHIFT", "C"))
 o.bind("SUPER + V", "Universal paste", universal_clipboard_shortcut("CTRL", "V", "CTRL SHIFT", "V"))
 o.bind("SUPER + X", "Universal cut", send_shortcut_once("CTRL", "X"))
diff --git a/default/hypr/bindings/utilities.lua b/default/hypr/bindings/utilities.lua
index 4f00ca8..fd6c723 100644
--- a/default/hypr/bindings/utilities.lua
+++ b/default/hypr/bindings/utilities.lua
@@ -97,7 +97,10 @@ o.bind("SUPER + CTRL + ALT + T", "Show time", "omarchy-notification-time")
 o.bind("SUPER + CTRL + ALT + B", "Show battery remaining", "omarchy-notification-battery")
 o.bind("SUPER + CTRL + ALT + W", "Toggle weather", "omarchy-notification-weather")
 
-o.bind("SUPER + SHIFT + CTRL + A", "Agent", "omarchy-agent --pick")
+-- omanix: the agent keys open the resident's chat and the approval card
+-- (DESIGN §h.5.4). Select all moved to SUPER + SHIFT + CTRL + A (clipboard.lua).
+o.bind("SUPER + A", "Agent chat", "omarchy-shell omanix.chat toggle")
+o.bind("SUPER + ALT + A", "Approvals", "omarchy-shell omanix.approval open")
 o.bind("SUPER + CTRL + A", "Audio", { panel = "omarchy.audio" })
 o.bind("SUPER + CTRL + B", "Bluetooth", { panel = "omarchy.bluetooth" })
 o.bind("SUPER + CTRL + D", "Display", { panel = "omarchy.monitor" })
