From: Ada <ada@6bit.com>
Date: Wed, 28 Oct 2026 17:02:12 -0600
Subject: [PATCH] P17: weather geolocation is opt-in via OMANIX_WEATHER_GEO_URL
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream geolocates through https://geo.omarchy.org/. omanix takes the URL
from omanix.weather.geoUrl (exported as OMANIX_WEATHER_GEO_URL by the
session module, W15); unset means no lookup and the user sets a location by
hand (DESIGN §f.2.5 P17).
---
 bin/omarchy-weather-location           | 5 +++--
 shell/plugins/panels/weather/Panel.qml | 7 ++++++-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/bin/omarchy-weather-location b/bin/omarchy-weather-location
index 8fa0fbd..3ab36fb 100755
--- a/bin/omarchy-weather-location
+++ b/bin/omarchy-weather-location
@@ -20,8 +20,9 @@ case "${1:-}" in
 "")
   name=""
   [[ -f $LOC_FILE ]] && name=$(jq -r '.name // "" | if type == "string" then . else "" end' "$LOC_FILE" 2>/dev/null)
-  if [[ -z $name ]]; then
-    name=$(curl -fsS --max-time 4 https://geo.omarchy.org/ 2>/dev/null | jq -r '.name // empty' 2>/dev/null)
+  # omanix: lookup only when omanix.weather.geoUrl is set (P17).
+  if [[ -z $name && -n ${OMANIX_WEATHER_GEO_URL:-} ]]; then
+    name=$(curl -fsS --max-time 4 "$OMANIX_WEATHER_GEO_URL" 2>/dev/null | jq -r '.name // empty' 2>/dev/null)
   fi
   [[ -n $name ]] && echo "$name"
   ;;
diff --git a/shell/plugins/panels/weather/Panel.qml b/shell/plugins/panels/weather/Panel.qml
index 0daf379..66d8f02 100644
--- a/shell/plugins/panels/weather/Panel.qml
+++ b/shell/plugins/panels/weather/Panel.qml
@@ -183,8 +183,13 @@ Panel {
     refreshDailyForecast(null)
   }
 
+  // omanix: the geolocation service is opt-in (omanix.weather.geoUrl, exported
+  // as OMANIX_WEATHER_GEO_URL). Unset means no lookup: set a place by hand.
+  readonly property string geoUrl: Quickshell.env("OMANIX_WEATHER_GEO_URL") || ""
+
   function detectLocation() {
     if (locationProc.running) return
+    if (root.geoUrl === "") return
     detectingLocation = true
     locationProc.running = true
   }
@@ -494,7 +499,7 @@ Panel {
   // this network, in weather.json's shape.
   Process {
     id: locationProc
-    command: ["curl", "-fsS", "--max-time", "4", "https://geo.omarchy.org/"]
+    command: ["curl", "-fsS", "--max-time", "4", root.geoUrl]
     stdout: StdioCollector {
       waitForEnd: true
       onStreamFinished: {
