# Helpers for the HM-owned dotfiles (§f.4.2). Every file that has an overlay
# names it in its **last** directive (checks.home-files-golden), using the
# include syntax of its format.
{ lib }:

rec {
  overlayDir = home: "${home}/.local/state/omanix/overlay";

  # The last directive that loads the overlay, per file format.
  include = {
    # Hyprland Lua: the generated loader in $OMARCHY_PATH (omanix-data).
    lua = name: ''require("default.hypr.omanix-overlay")("${name}")'';
    # hyprlang `source =` (hyprsunset); the overlay always exists (session init).
    hyprlang = home: rel: "source = ${overlayDir home}/${rel}";
    kitty = home: rel: "include ${overlayDir home}/${rel}";
    # ghostty: `?` makes a missing file non-fatal.
    ghostty = home: rel: ''config-file = ?"${overlayDir home}/${rel}"'';
    foot = home: rel: "include=${overlayDir home}/${rel}";
    xcompose = home: rel: ''include "${overlayDir home}/${rel}"'';
    bash = home: rel: ''[ -r "${overlayDir home}/${rel}" ] && . "${overlayDir home}/${rel}"'';
    css = home: rel: ''@import url("file://${overlayDir home}/${rel}");'';
    fontconfig = home: rel: ''<include ignore_missing="yes">${overlayDir home}/${rel}</include>'';
  };

  # "omanix-generated" banner for HM files (comment syntax per format).
  banner = comment: module: ''
    ${comment} omanix: generated by ${module} from your host configuration (read-only).
    ${comment} Change it through omanix.* options, or ask your agent. Runtime changes go in the
    ${comment} overlay named at the end of this file.
  '';

  # A file's text ends with exactly one overlay directive.
  withOverlay = text: directive: lib.removeSuffix "\n" text + "\n\n" + directive + "\n";
}
