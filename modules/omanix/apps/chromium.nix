# omanix.apps.chromium: Chromium's flags file and the wrapper that reads it
# (§f.4.2, §f.5). Arch's chromium reads ~/.config/chromium-flags.conf;
# nixpkgs' does not. The wrapper passes the flags from the read-only HM file
# and then from overlay/chromium-flags.conf (where omarchy-chromium-add-
# feature writes at runtime), merging --enable-features into one flag.
#
# The base app list (omanix.apps.<name>.enable, W17) decides whether Chromium
# is installed; when it is, it is this wrapper (omanix.apps.chromium.package).
{ config, lib, pkgs, ... }:

let
  cfg = config.omanix;
  user = config.loom.user.name;
  home = config.users.users.${user}.home;
  homeLib = import ../../../lib/home { inherit lib; };
  c = cfg.apps.chromium;

  # Upstream's config/chromium-flags.conf with the fork's rewrite
  # (/usr/share/omarchy -> OMARCHY_PATH), read from the pinned source so no
  # build output is read at evaluation time.
  upstream = builtins.replaceStrings [ "/usr/share/omarchy" ] [ cfg.path ]
    (builtins.readFile "${pkgs.omanixFork.src}/config/chromium-flags.conf");
  lines = lib.splitString "\n" (lib.removeSuffix "\n" upstream);
  isFeatures = l: lib.hasPrefix "--enable-features=" l;
  withFeatures =
    if c.features == [ ] then lines
    else if lib.any isFeatures lines
    then map (l: if isFeatures l then l + "," + lib.concatStringsSep "," c.features else l) lines
    else lines ++ [ "--enable-features=${lib.concatStringsSep "," c.features}" ];
  flagsText = lib.concatStringsSep "\n" ([
    "# omanix: generated by apps/chromium.nix (read-only). Set omanix.apps.chromium.features,"
    "# or ask your agent. The chromium wrapper reads this file, then the overlay below."
  ] ++ withFeatures ++ [
    ""
    "# Runtime flags (omarchy-chromium-add-feature): ${homeLib.overlayDir home}/chromium-flags.conf"
  ]) + "\n";

  wrapper = chromium:
    let
      launch = bin: pkgs.writeShellScript "chromium-omanix-${bin}" ''
        # omanix: Chromium with ~/.config/chromium-flags.conf and its overlay.
        mapfile -d "" -t flags < <(${lib.getExe pkgs.omanix-chromium-flags} -0)
        exec ${chromium}/bin/${bin} "''${flags[@]}" "$@"
      '';
    in
    pkgs.symlinkJoin {
      name = "chromium-omanix-${chromium.version or "unknown"}";
      paths = [ chromium ];
      postBuild = ''
        for b in chromium chromium-browser; do
          [ -e $out/bin/$b ] || continue
          rm $out/bin/$b
        done
        ln -s ${launch "chromium"} $out/bin/chromium
        [ -e ${chromium}/bin/chromium-browser ] && ln -s ${launch "chromium-browser"} $out/bin/chromium-browser || true
      '';
      passthru = { unwrapped = chromium; };
      meta = (chromium.meta or { }) // { mainProgram = "chromium"; };
    };
in
{
  options.omanix.apps.chromium = {
    features = lib.mkOption {
      type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9]+");
      default = [ ];
      example = [ "WebRTCPipeWireCapturer" ];
      description = "Chromium features to enable, added to upstream's `--enable-features` in ~/.config/chromium-flags.conf.";
    };
    package = lib.mkOption {
      type = lib.types.package;
      default = wrapper pkgs.chromium;
      defaultText = lib.literalExpression "pkgs.chromium wrapped to read ~/.config/chromium-flags.conf and its overlay";
      example = lib.literalExpression "pkgs.chromium.override { enableWideVine = true; }";
      apply = p: if p ? unwrapped then p else wrapper p;
      description = "The Chromium the base app list installs; any package given here is wrapped to read the flags files.";
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge [
    (lib.mkIf (c.enable or false) {
      environment.systemPackages = [ c.package ];
    })
    (lib.mkIf cfg.home.enable {
      home-manager.users.${user}.xdg.configFile."chromium-flags.conf".text = flagsText;
      omanix.home.files.".config/chromium-flags.conf" = { module = "apps/chromium.nix"; overlay = "chromium-flags.conf"; };
    })
  ]);
}
