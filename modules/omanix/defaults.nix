# omanix.defaults: the default terminal, browser, editor and dictation
# backend (§f.4.2, §f.4.5). Upstream's `omarchy-default-*` writers are
# AGENT-INTENT; their no-argument readers (fork/add) print these values from
# catalog/config.json.
#
# HM (read-only): ~/.config/xdg-terminals.list, ~/.config/omarchy/defaults/
# dictation, ~/.local/state/omarchy/defaults/editor, and upstream's
# ~/.config/hyprland-mimeapps.list. The default browser lives in
# mimeapps.list, which is app-owned: activation sets it only when it differs.
{ config, lib, pkgs, ... }:

let
  cfg = config.omanix;
  dcfg = cfg.defaults;
  user = config.loom.user.name;
  up = cfg.fork.package;

  terminals = {
    alacritty = { package = pkgs.alacritty; desktop = "Alacritty.desktop"; };
    foot = { package = pkgs.foot; desktop = "foot.desktop"; };
    ghostty = { package = pkgs.ghostty; desktop = "com.mitchellh.ghostty.desktop"; };
    kitty = { package = pkgs.kitty; desktop = "kitty.desktop"; };
  };
  browsers = {
    chromium = { package = pkgs.chromium; desktop = "chromium.desktop"; };   # apps/default.nix ships the alias upstream expects
    brave = { package = pkgs.brave; desktop = "brave-browser.desktop"; };
    firefox = { package = pkgs.firefox; desktop = "firefox.desktop"; };
    chrome = { package = pkgs.google-chrome; desktop = "google-chrome.desktop"; unfree = true; };
  };
  editors = {
    nvim = pkgs.neovim;
    helix = pkgs.helix;
    vim = pkgs.vim;
    emacs = pkgs.emacs;
    code = pkgs.vscode;
    zed = pkgs.zed-editor;
  };
  dictation = {
    voxtype = pkgs.voxtype;
    none = null;
  };
  browser = browsers.${dcfg.browser};
  xdgSettings = "${pkgs.xdg-utils}/bin/xdg-settings";
in
{
  options.omanix.defaults = {
    terminal = lib.mkOption {
      type = lib.types.enum (builtins.attrNames terminals);
      default = "foot";
      example = "alacritty";
      description = "The terminal xdg-terminal-exec starts (~/.config/xdg-terminals.list).";
    };
    browser = lib.mkOption {
      type = lib.types.enum (builtins.attrNames browsers);
      default = "chromium";
      example = "firefox";
      description = "The default web browser (set in the app-owned mimeapps.list at activation when it differs). chrome is unfree (choosing it allows it in loom.nixpkgs.allowUnfree).";
    };
    editor = lib.mkOption {
      type = lib.types.enum (builtins.attrNames editors);
      default = "nvim";
      example = "helix";
      description = "The editor `omarchy-launch-editor` opens (nvim gets omarchy's LazyVim config at first login). code is unfree (choosing it allows it in loom.nixpkgs.allowUnfree).";
    };
    dictation = lib.mkOption {
      type = lib.types.enum (builtins.attrNames dictation);
      default = "voxtype";
      example = "none";
      description = "The dictation backend (`omarchy-default-dictation`).";
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ terminals.${dcfg.terminal}.package browser.package editors.${dcfg.editor} ]
      ++ lib.optional (dictation.${dcfg.dictation} != null) dictation.${dcfg.dictation};
    # The unfree choices (chrome, code) allow themselves.
    loom.nixpkgs.allowUnfree = lib.optional (browser.unfree or false) (lib.getName browser.package)
      ++ lib.optional (dcfg.editor == "code") (lib.getName editors.code);

    home-manager.users.${user} = lib.mkIf cfg.home.enable ({ lib, ... }: {
      xdg.configFile."xdg-terminals.list".text = ''
        # omanix: generated by defaults.nix from omanix.defaults.terminal (read-only).
        # Terminal emulator preference order for xdg-terminal-exec
        ${terminals.${dcfg.terminal}.desktop}
      '';
      xdg.configFile."omarchy/defaults/dictation".text = dcfg.dictation + "\n";
      home.file.".local/state/omarchy/defaults/editor".text = dcfg.editor + "\n";
      xdg.configFile."hyprland-mimeapps.list".source = "${up}/config/hyprland-mimeapps.list";

      # §f.4.5 step 3: mimeapps.list is app-owned; only fix the browser when it
      # differs. xdg-settings needs no session bus for the generic desktop
      # (it writes mimeapps.list through xdg-mime), so this works at boot (U35);
      # it does need the browser's Exec on PATH and the desktop files on
      # XDG_DATA_DIRS, which HM activation doesn't have.
      home.activation.omanixDefaults = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
        xdg() {
          env -u BROWSER XDG_CURRENT_DESKTOP= PATH=${lib.makeBinPath [ pkgs.xdg-utils pkgs.coreutils pkgs.gnugrep pkgs.gnused pkgs.gawk pkgs.findutils pkgs.which ]}:/etc/profiles/per-user/${user}/bin:/run/current-system/sw/bin:$PATH \
            XDG_DATA_DIRS=/etc/profiles/per-user/${user}/share:/run/current-system/sw/share ${xdgSettings} "$@"
        }
        mkdir -p "''${XDG_CONFIG_HOME:-$HOME/.config}"
        current=$(xdg get default-web-browser 2>/dev/null || true)
        if [ "$current" != ${lib.escapeShellArg browser.desktop} ]; then
          run xdg set default-web-browser ${lib.escapeShellArg browser.desktop} \
            || echo "omanixDefaults: could not set the default browser to ${browser.desktop}" >&2
        fi
      '';
    });

    omanix.home.files = {
      ".config/xdg-terminals.list" = { module = "defaults.nix"; };
      ".config/omarchy/defaults/dictation" = { module = "defaults.nix"; };
      ".local/state/omarchy/defaults/editor" = { module = "defaults.nix"; };
      ".config/hyprland-mimeapps.list" = { module = "defaults.nix"; };
    };
  };
}
