# omanix.fonts: the font set, fontconfig defaults, and the HM fonts.conf
# (§f.4.2). The monospace family also reaches the terminals' HM files
# (home/terminals.nix). `omarchy-font-set` changes it at runtime through the
# overlays; "make it stick" sets omanix.fonts.monospace.
{ config, lib, pkgs, ... }:

let
  cfg = config.omanix;
  fcfg = cfg.fonts;
  user = config.loom.user.name;
  home = config.users.users.${user}.home;
  homeLib = import ../../lib/home { inherit lib; };
  up = cfg.fork.package;

  xmlEscape = lib.replaceStrings [ "&" "<" ">" ] [ "&amp;" "&lt;" "&gt;" ];

  cjkPrefer = lib.optionalString (fcfg.cjk != null) (lib.concatMapStrings (fam: ''
    <alias>
      <family>${fam}</family>
      <prefer><family>Noto ${if fam == "monospace" then "Sans Mono" else if fam == "serif" then "Serif" else "Sans"} CJK ${fcfg.cjk}</family></prefer>
    </alias>
  '') [ "sans-serif" "serif" "monospace" ]);

  # The HM fonts.conf: omanix.fonts.monospace first for "monospace", then the
  # overlay (a file, not a directory: a directory include only loads
  # [0-9]*.conf), whose own prepend_first comes later and so wins. The include
  # shares its line with </fontconfig>, so it is the file's last directive.
  fontsConf = homeLib.withOverlay ''
    <?xml version="1.0"?>
    <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
    <!-- omanix: generated by fonts.nix from your host configuration (read-only).
         Change it through omanix.fonts.*, or ask your agent. Runtime changes
         (omarchy-font-set) go in the overlay included at the end. -->
    <fontconfig>
      <match target="pattern">
        <test name="family" qual="any"><string>monospace</string></test>
        <edit name="family" mode="prepend_first" binding="strong">
          <string>${xmlEscape fcfg.monospace}</string>
        </edit>
      </match>
    ${cjkPrefer}''
    (homeLib.include.fontconfig home "fontconfig/fonts.conf" + "</fontconfig>");
in
{
  options.omanix.fonts = {
    monospace = lib.mkOption {
      type = lib.types.strMatching "[A-Za-z0-9 _.+-]+";
      default = "JetBrainsMono Nerd Font";
      example = "CaskaydiaMono Nerd Font";
      description = ''
        The monospace family: fontconfig's `monospace`, the terminals, the
        shell. Its package must be in omanix.fonts.packages (or fonts.packages).
      '';
    };
    size = lib.mkOption {
      type = lib.types.ints.between 6 32;
      default = 9;
      example = 11;
      description = "The terminals' font size in points (omarchy-display-text-size changes it at runtime).";
    };
    cjk = lib.mkOption {
      type = lib.types.nullOr (lib.types.enum [ "JP" "KR" "SC" "TC" "HK" ]);
      default = null;
      example = "JP";
      description = "Preferred Noto CJK variant for Han characters; null keeps upstream's per-language rules.";
    };
    packages = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default = with pkgs; [
        nerd-fonts.jetbrains-mono
        noto-fonts
        noto-fonts-cjk-sans
        noto-fonts-cjk-serif
        noto-fonts-color-emoji
        font-awesome
        liberation_ttf
        ia-writer-duospace
        ia-writer-quattro
      ];
      defaultText = lib.literalExpression "[ nerd-fonts.jetbrains-mono noto-fonts noto-fonts-cjk-sans … ]";
      example = lib.literalExpression "[ pkgs.nerd-fonts.caskaydia-mono ]";
      description = "Fonts installed system-wide (omarchy's base fonts plus omarchy's icon font, always).";
    };
  };

  config = lib.mkIf cfg.enable {
    fonts.packages = fcfg.packages ++ [
      # omarchy's private-use icon font (bar glyphs, logo).
      (pkgs.runCommand "omarchy-icon-font" { } ''
        install -Dm644 ${up}/default/fonts/omarchy/omarchy.ttf $out/share/fonts/truetype/omarchy.ttf
      '')
    ];
    fonts.fontconfig.enable = lib.mkDefault true;
    # Upstream's 50-omarchy.conf: CJK language folding and generic fallbacks.
    fonts.fontconfig.localConf = lib.mkDefault (builtins.readFile "${cfg.fork.src}/default/fontconfig/conf.avail/50-omarchy.conf");
    fonts.fontconfig.defaultFonts.monospace = lib.mkDefault [ fcfg.monospace ];

    home-manager.users.${user} = lib.mkIf cfg.home.enable {
      xdg.configFile."fontconfig/fonts.conf".text = fontsConf;
    };
    omanix.home.files.".config/fontconfig/fonts.conf" = { module = "fonts.nix"; overlay = "fontconfig/fonts.conf"; };

    # What `omanix-overlay settle` drops from the overlays once declared
    # (omarchy-font-set / omarchy-display-text-size write these keys).
    omanix.runtime.settle = let size = toString fcfg.size; q = "\"${fcfg.monospace}\""; in {
      monospace = fcfg.monospace;
      kv = {
        "alacritty.toml" = { "font.normal.family" = q; "font.bold.family" = q; "font.italic.family" = q; "font.size" = size; };
        "kitty.conf" = { font_family = fcfg.monospace; font_size = "${size}.0"; };
        "ghostty.conf" = { font-family = q; font-size = size; };
        "foot.ini" = { font = "${fcfg.monospace}:size=${size}"; };
      };
    };
  };
}
