# The rest of the desktop's HM files (§f.4.2): bash, git, GTK 4, btop's theme
# link, and upstream's files that have no overlay. Fonts, input, XCompose,
# defaults and chromium flags are W17's (fonts.nix, input.nix, defaults.nix,
# apps); themes are W16's.
{ config, lib, pkgs, ... }:

let
  cfg = config.omanix;
  user = config.loom.user.name;
  home = config.users.users.${user}.home;
  homeLib = import ../../../lib/home { inherit lib; };
  up = "${cfg.fork.package}/config";

  # Upstream files HM links as they are (override with lib.mkForce on .source).
  plain = [
    "starship.toml"
    "tmux/tmux.conf"
    "herdr/config.toml"
    "lazygit/config.yml"
    "imv/config"
    "obsidian/user-flags.conf"
    "hyprland-preview-share-picker/config.yaml"
    "xdg-desktop-portal/hyprland-portals.conf"
    "autostart/org.fcitx.Fcitx5.desktop"
    "autostart/print-applet.desktop"
  ] ++ map (f: "wireplumber/wireplumber.conf.d/${f}")
    (builtins.attrNames (builtins.readDir "${up}/wireplumber/wireplumber.conf.d"));

  gitConfig = builtins.readFile "${up}/git/config" + ''

    # omanix: from loom.user (home/desktop.nix). Your own settings go in ~/.gitconfig.
    [user]
    	name = ${config.loom.user.fullName}
    	email = ${config.loom.user.email}
  '';
in
{
  config = lib.mkIf (cfg.enable && cfg.home.enable) {
    home-manager.users.${user} = { config, ... }: {
      xdg.configFile = lib.genAttrs plain (f: { source = "${up}/${f}"; }) // {
        "git/config".text = gitConfig;
        "gtk-4.0/gtk.css".text = homeLib.withOverlay
          "/* omanix: generated by home/desktop.nix (read-only); runtime changes go in the overlay. */\n"
          (homeLib.include.css home "gtk4.css");
        "btop/themes/current.theme".source =
          config.lib.file.mkOutOfStoreSymlink "${home}/.local/state/omarchy/current/theme/btop.theme";
      };
      home.file.".bashrc".text = homeLib.withOverlay (builtins.readFile "${cfg.fork.package}/default/bashrc")
        (homeLib.include.bash home "bashrc");
    };

    omanix.home.files = lib.genAttrs (map (f: ".config/${f}") plain) (_: { module = "home/desktop.nix"; }) // {
      ".config/git/config" = { module = "home/desktop.nix"; };
      ".config/gtk-4.0/gtk.css" = { module = "home/desktop.nix"; overlay = "gtk4.css"; };
      ".config/btop/themes/current.theme" = { module = "home/desktop.nix"; };
      ".bashrc" = { module = "home/desktop.nix"; overlay = "bashrc"; };
    };
  };
}
