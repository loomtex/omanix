# The terminals' HM files (§f.4.2): upstream's configs, each loading the
# theme first and its overlay last. Alacritty loads the importing file last,
# so alacritty.toml holds only the import list.
{ config, lib, pkgs, ... }:

let
  cfg = config.omanix;
  user = config.loom.user.name;
  home = config.users.users.${user}.home;
  homeLib = import ../../../lib/home { inherit lib; };
  up = "${cfg.fork.package}/config";
  toml = pkgs.formats.toml { };
  ov = homeLib.overlayDir home;

  alacrittyUp = builtins.fromTOML (builtins.readFile "${up}/alacritty/alacritty.toml");
  alacrittyTheme = lib.head alacrittyUp.general.import;

  # foot: `include=` must be the last key of [main] (a later section in the
  # main file still wins for that section).
  footIni =
    let
      lines = lib.splitString "\n" (builtins.readFile "${up}/foot/foot.ini");
      idx = lib.findFirst (i: i > 0 && lib.hasPrefix "[" (builtins.elemAt lines i)) (builtins.length lines)
        (lib.range 0 (builtins.length lines - 1));
      before = lib.take idx lines;
      after = lib.drop idx lines;
      lastKey = lib.foldl' (acc: i: if builtins.elemAt before i != "" then i else acc) 0 (lib.range 0 (builtins.length before - 1));
      trimmed = lib.take (lastKey + 1) before;
    in
    lib.concatStringsSep "\n" (trimmed ++ [ (homeLib.include.foot home "foot.ini") "" ] ++ after);
in
{
  config = lib.mkIf (cfg.enable && cfg.home.enable) {
    home-manager.users.${user}.xdg.configFile = {
      "alacritty/alacritty.toml".text = ''
        # omanix: generated by home/terminals.nix (read-only). Only the import
        # list lives here: alacritty loads this file last, so a key here would
        # beat the overlay.
        general.import = ${builtins.toJSON [ alacrittyTheme "~/.config/alacritty/omanix-base.toml" "~/.config/alacritty/omanix.toml" "${ov}/alacritty.toml" ]}
      '';
      "alacritty/omanix-base.toml".source = toml.generate "omanix-base.toml"
        (builtins.removeAttrs alacrittyUp [ "general" "font" ]);
      # [font] from omanix.fonts (W17's fonts.nix); upstream's until then.
      "alacritty/omanix.toml".source = toml.generate "omanix.toml" { inherit (alacrittyUp) font; };

      "kitty/kitty.conf".text = homeLib.withOverlay (builtins.readFile "${up}/kitty/kitty.conf")
        (homeLib.include.kitty home "kitty.conf");
      "ghostty/config".text = homeLib.withOverlay (builtins.readFile "${up}/ghostty/config")
        (homeLib.include.ghostty home "ghostty.conf");
      "foot/foot.ini".text = footIni;
    };

    omanix.home.files = {
      ".config/alacritty/alacritty.toml" = { module = "home/terminals.nix"; overlay = "alacritty.toml"; };
      ".config/alacritty/omanix-base.toml" = { module = "home/terminals.nix"; };
      ".config/alacritty/omanix.toml" = { module = "home/terminals.nix"; };
      ".config/kitty/kitty.conf" = { module = "home/terminals.nix"; overlay = "kitty.conf"; };
      ".config/ghostty/config" = { module = "home/terminals.nix"; overlay = "ghostty.conf"; };
      ".config/foot/foot.ini" = { module = "home/terminals.nix"; overlay = "foot.ini"; };
    };
  };
}
