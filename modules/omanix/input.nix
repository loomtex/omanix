# omanix.input: keyboard layouts, XKB options, compose, touchpad (§f.4.2).
#
# HM files (read-only): ~/.config/hypr/input.lua (hl.config input from these
# options, then overlay/hypr/input.lua), ~/.config/omarchy/keyboard-layouts
# (read unchanged by upstream's keyboard.lua) and ~/.XCompose (upstream's
# xcompose.sh text with loom.user, then the overlay). The keyboard picker
# (omarchy-setup-keyboard, fork/add) writes the overlay's keyboard block
# (U28); "make it stick" sets omanix.input.layouts.
{ config, lib, pkgs, ... }:

let
  cfg = config.omanix;
  icfg = cfg.input;
  user = config.loom.user.name;
  home = config.users.users.${user}.home;
  lua = import ../../lib/lua.nix { inherit lib; };
  homeLib = import ../../lib/home { inherit lib; };
  up = cfg.fork.package;

  split = l: let p = lib.splitString ":" l; in { layout = lib.head p; variant = if lib.length p > 1 then lib.elemAt p 1 else ""; };
  parts = map split icfg.layouts;
  xkbLayout = lib.concatMapStringsSep "," (p: p.layout) parts;
  xkbVariant = lib.concatMapStringsSep "," (p: p.variant) parts;

  # Upstream's list (default/hypr/input.lua): layouts that can't type Latin letters.
  nonLatin = lib.splitString " " "af am ara bd bg by et ge gr il in iq ir kg kh kz la lk mk mm mn mv np rs ru sy th tj ua";
  kbOptions = lib.optional icfg.compose "omarchy:shift_caps_compose"
    ++ lib.optional (lib.any (p: builtins.elem p.layout nonLatin) parts && !(lib.any (lib.hasPrefix "grp:") icfg.options)) "grp:alts_toggle"
    ++ icfg.options;

  touchpad = lib.filterAttrs (_: v: v != null) {
    natural_scroll = icfg.touchpad.naturalScroll;
    clickfinger_behavior = icfg.touchpad.clickfinger;
    scroll_factor = icfg.touchpad.scrollFactor;
    disable_while_typing = icfg.touchpad.disableWhileTyping;
  };
  input = lib.filterAttrs (_: v: v != null && v != { }) {
    # Only what differs from upstream's defaults is written; upstream's
    # default/hypr/input.lua computes the rest from keyboard-layouts.
    kb_options = if icfg.options != [ ] || !icfg.compose then lib.concatStringsSep "," kbOptions else null;
    repeat_rate = icfg.repeat.rate;
    repeat_delay = icfg.repeat.delay;
    sensitivity = icfg.sensitivity;
    inherit touchpad;
  };

  inputLua = homeLib.withOverlay
    (homeLib.banner "--" "omanix.input (modules/omanix/input.nix)"
      + lib.optionalString (input != { }) "hl.config(${lua.toLua { inherit input; }})\n"
      + cfg.hyprland.fileLua.input)
    (homeLib.include.lua "input");

  keyboardLayouts = ''
    # omanix: generated by input.nix from omanix.input.layouts (read-only).
    XKBLAYOUT=${xkbLayout}
    XKBVARIANT=${xkbVariant}
  '';

  # upstream install/user/xcompose.sh, with the identity from loom.user
  xcompose = homeLib.withOverlay ''
    # omanix: generated by input.nix (read-only). Your own sequences go in the
    # overlay included at the end; run omarchy-restart-xcompose to apply.

    # Include fast emoji access
    include "${cfg.path}/default/xcompose"

    # Identification
    <Multi_key> <space> <n> : "${lib.escape [ "\"" "\\" ] config.loom.user.fullName}"
    <Multi_key> <space> <e> : "${lib.escape [ "\"" "\\" ] config.loom.user.email}"
  '' (homeLib.include.xcompose home "xcompose");

  # upstream omarchy-restart-trackpad, as a root oneshot (fork/add: privilege = unit)
  trackpadReset = pkgs.writeShellScript "omanix-trackpad-reset" ''
    PATH=${lib.makeBinPath [ pkgs.coreutils pkgs.kmod pkgs.gnugrep ]}
    for dev in /sys/bus/i2c/drivers/i2c_hid_acpi/i2c-*; do
      [ -e "$dev" ] || continue
      d=$(basename "$dev")
      echo "Resetting $d via i2c_hid_acpi unbind/rebind..."
      echo "$d" > /sys/bus/i2c/drivers/i2c_hid_acpi/unbind
      sleep 1
      echo "$d" > /sys/bus/i2c/drivers/i2c_hid_acpi/bind
    done
    if lsmod | grep -q intel_quicki2c; then
      modprobe -r intel_quicki2c && modprobe intel_quicki2c
    fi
  '';
in
{
  options.omanix.input = {
    layouts = lib.mkOption {
      type = lib.types.nonEmptyListOf (lib.types.strMatching "[a-z][a-z0-9_-]*(:[A-Za-z0-9_-]+)?");
      default = [ config.loom.locale.keyMap ];
      defaultText = lib.literalExpression "[ config.loom.locale.keyMap ]";
      example = [ "us" "de:nodeadkeys" ];
      description = ''
        Keyboard layouts in switching order, as `layout` or `layout:variant`
        (XKB names). The first one leads; upstream keeps a Latin layout first
        so the keybindings work. Also the XKB layout of the system
        (services.xserver.xkb); the console keymap stays loom.locale.keyMap.
      '';
    };
    options = lib.mkOption {
      type = lib.types.listOf (lib.types.strMatching "[a-z0-9_]+:[A-Za-z0-9_]+");
      default = [ ];
      example = [ "grp:alts_toggle" "ctrl:nocaps" ];
      description = "Extra XKB options (kb_options), after the compose key.";
    };
    compose = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Shift + Caps Lock is the Compose key (omarchy's own XKB option, ~/.XCompose).";
    };
    repeat = {
      rate = lib.mkOption { type = lib.types.nullOr lib.types.ints.positive; default = null; example = 40; description = "Key repeat rate (upstream: 40)."; };
      delay = lib.mkOption { type = lib.types.nullOr lib.types.ints.positive; default = null; example = 250; description = "Key repeat delay in ms (upstream: 250)."; };
    };
    sensitivity = lib.mkOption {
      type = lib.types.nullOr (lib.types.numbers.between (-1) 1);
      default = null;
      example = 0.35;
      description = "Pointer sensitivity (upstream: 0).";
    };
    touchpad = {
      naturalScroll = lib.mkOption { type = lib.types.nullOr lib.types.bool; default = null; example = true; description = "Natural (inverse) scrolling (upstream: off)."; };
      clickfinger = lib.mkOption { type = lib.types.nullOr lib.types.bool; default = null; example = false; description = "Two-finger click for right-click (upstream: on)."; };
      scrollFactor = lib.mkOption { type = lib.types.nullOr lib.types.number; default = null; example = 0.6; description = "Touchpad scroll speed (upstream: 0.4)."; };
      disableWhileTyping = lib.mkOption { type = lib.types.nullOr lib.types.bool; default = null; example = false; description = "Ignore the touchpad while typing (Hyprland default: on)."; };
    };
  };

  config = lib.mkIf cfg.enable {
    services.xserver.xkb = {
      layout = lib.mkOverride 999 xkbLayout;
      variant = lib.mkOverride 999 xkbVariant;
    };

    # omarchy's XKB option (Shift + Caps Lock = Compose); libxkbcommon reads /etc/xkb first.
    environment.etc."xkb/rules/evdev".source = "${up}/etc/xkb/rules/evdev";
    environment.etc."xkb/symbols/omarchy".source = "${up}/etc/xkb/symbols/omarchy";

    # Fcitx5 with upstream's input-method engines; upstream's omarchy-fcitx5
    # user unit starts it (its xdg autostart entry is hidden in HM).
    i18n.inputMethod = {
      enable = lib.mkDefault true;
      type = lib.mkDefault "fcitx5";
      fcitx5.waylandFrontend = lib.mkDefault true;
      fcitx5.addons = with pkgs; [
        fcitx5-gtk qt6Packages.fcitx5-chinese-addons fcitx5-mozc fcitx5-hangul fcitx5-chewing fcitx5-table-extra
      ];
    };

    # The keyboard picker's catalog (evdev.lst) and python.
    environment.systemPackages = [ pkgs.xkeyboard_config (pkgs.python3.withPackages (p: [ p.pygobject3 ])) ];
    environment.pathsToLink = [ "/share/X11/xkb" ];

    # omarchy-restart-trackpad (fork/add): this unit, startable by the active local user.
    systemd.services.omanix-trackpad-reset = {
      description = "omanix: reset the trackpad (i2c-hid unbind/rebind)";
      serviceConfig = { Type = "oneshot"; ExecStart = trackpadReset; };
    };
    security.polkit.extraConfig = ''
      // omanix (input.nix): omarchy-restart-trackpad
      polkit.addRule(function(action, subject) {
        if (action.id == "org.freedesktop.systemd1.manage-units" &&
            action.lookup("unit") == "omanix-trackpad-reset.service" &&
            action.lookup("verb") == "start" &&
            subject.local && subject.active && subject.user == "${user}") {
          return polkit.Result.YES;
        }
      });
    '';

    home-manager.users.${user} = lib.mkIf cfg.home.enable {
      xdg.configFile."hypr/input.lua".text = inputLua;
      xdg.configFile."omarchy/keyboard-layouts".text = keyboardLayouts;
      home.file.".XCompose".text = xcompose;
    };
    # The keyboard picker's block in overlay/hypr/input.lua settles once declared.
    omanix.runtime.settle.keyboard = { layouts = xkbLayout; variants = xkbVariant; };

    omanix.home.files = {
      ".config/hypr/input.lua" = { module = "input.nix"; overlay = "hypr/input.lua"; };
      ".config/omarchy/keyboard-layouts" = { module = "input.nix"; };
      ".XCompose" = { module = "input.nix"; overlay = "xcompose"; };
    };
  };
}
