# omanix: generated by input.nix (read-only). Your own sequences go in the
# overlay included at the end; run omarchy-restart-xcompose to apply.

# Include fast emoji access
include "/run/current-system/omarchy/default/xcompose"

# Identification
<Multi_key> <space> <n> : "Alice Example"
<Multi_key> <space> <e> : "alice@example.org"

include "/home/alice/.local/state/omanix/overlay/xcompose"
